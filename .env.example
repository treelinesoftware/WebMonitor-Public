# WebMonitor Docker settings. Copy to .env next to compose.yaml and edit.

# Required: the database password for WebMonitor's own database user.
# Make one with:  openssl rand -hex 24
WEBMON_DB_PASSWORD=

# Optional: password for the first 'admin' login (10+ characters). Left empty, one is generated
# and shown once in the app container's log (docker compose logs app).
WEBMON_ADMIN_PASSWORD=

# Names and addresses people and agents use to reach this server, comma
# separated (e.g. monitor.example.lan,192.168.1.10). Added to the self-signed
# certificate when it's first made; the host's own addresses are always added.
WEBMON_HOSTNAME=

# Ports. With compose.yaml these are opened on the host itself, so pick ones
# nothing else uses. Plain HTTP only redirects to HTTPS.
WEBMON_HTTPS_PORT=8443
WEBMON_HTTP_PORT=8080
# NetFlow/IPFIX from your switches and routers (UDP).
WEBMON_FLOW_PORT=2055
# Only accept flows from these addresses (comma separated). Empty = any.
WEBMON_FLOW_EXPORTERS=

# compose.yaml only: the database listens on this port on 127.0.0.1.
WEBMON_DB_PORT=3307
# Database memory. 512M suits up to ~100 devices with NetFlow; use 1G or more for larger networks.
WEBMON_DB_BUFFER_POOL=512M

# Timezone for times in alerts and logs, e.g. America/Toronto.
TZ=UTC

# 1 = write Apache's access log to the container log (busy: the dashboard polls every few seconds).
WEBMON_ACCESS_LOG=0
